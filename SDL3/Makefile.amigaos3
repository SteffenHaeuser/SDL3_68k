# Pre-main isolation diagnostics.
START_DIAG_DIR=build/clib2-sw/startdiag
START_BASE=-std=gnu99 -O0 -mcpu=68040 -mhard-float -mcrt=clib2 -DNOIXEMUL $(TEST_COMMON)

$(START_DIAG_DIR)/test_start_plain: examples/amigaos3/test_start_plain.c
	@mkdir -p $(@D)
	$(CC) $(START_BASE) $< -lamiga -o $@

$(START_DIAG_DIR)/test_start_linklibs: examples/amigaos3/test_start_linklibs.c
	@mkdir -p $(@D)
	$(CC) $(START_BASE) $< $(TEST_LIBS_SW) -o $@

$(START_DIAG_DIR)/test_start_sdllink: examples/amigaos3/test_start_sdllink.c build/clib2-sw/libSDL3_sw.a
	@mkdir -p $(@D)
	$(CC) $(START_BASE) $< build/clib2-sw/libSDL3_sw.a $(TEST_LIBS_SW) -o $@

$(START_DIAG_DIR)/test_start_sdlversion: examples/amigaos3/test_start_sdlversion.c build/clib2-sw/libSDL3_sw.a
	@mkdir -p $(@D)
	$(CC) $(START_BASE) $< build/clib2-sw/libSDL3_sw.a $(TEST_LIBS_SW) \
		-Wl,-Map,$(START_DIAG_DIR)/test_start_sdlversion.map -Wl,--cref -o $@

startupdiag-clib2: $(START_DIAG_DIR)/test_start_plain \
                   $(START_DIAG_DIR)/test_start_linklibs \
                   $(START_DIAG_DIR)/test_start_sdllink \
                   $(START_DIAG_DIR)/test_start_sdlversion


# Produce a compact text report of what the sdlversion link pulled in.
startupdiag-report-clib2: $(START_DIAG_DIR)/test_start_sdlversion
	@echo "=== Archive members pulled into test_start_sdlversion ===" > $(START_DIAG_DIR)/startupdiag-report.txt
	@sed -n '/^Archive member included/,/^Allocating common symbols/p' $(START_DIAG_DIR)/test_start_sdlversion.map >> $(START_DIAG_DIR)/startupdiag-report.txt
	@echo "" >> $(START_DIAG_DIR)/startupdiag-report.txt
	@echo "=== Sections in executable ===" >> $(START_DIAG_DIR)/startupdiag-report.txt
	@m68k-amigaos-objdump -h $(START_DIAG_DIR)/test_start_sdlversion >> $(START_DIAG_DIR)/startupdiag-report.txt 2>&1 || true
	@echo "" >> $(START_DIAG_DIR)/startupdiag-report.txt
	@echo "=== Constructor/init related symbols ===" >> $(START_DIAG_DIR)/startupdiag-report.txt
	@m68k-amigaos-nm -n $(START_DIAG_DIR)/test_start_sdlversion 2>/dev/null | grep -Ei 'ctor|dtor|init|exit|startup|library' >> $(START_DIAG_DIR)/startupdiag-report.txt || true
	@echo "Wrote $(START_DIAG_DIR)/startupdiag-report.txt"


CTOR_DIAG_DIR=build/clib2-sw/ctordiag
CTOR_BASE=-std=gnu99 -O0 -mcpu=68040 -mhard-float -mcrt=clib2 -DNOIXEMUL -I./include -I./include/build_config -I./include/SDL3 -D__AMIGAOS3__

$(CTOR_DIAG_DIR)/test_ctor_math: examples/amigaos3/test_ctor_math.c
	@mkdir -p $(@D)
	$(CC) $(CTOR_BASE) $< -lamiga -lm -lstubs -o $@

$(CTOR_DIAG_DIR)/test_ctor_stdio: examples/amigaos3/test_ctor_stdio.c
	@mkdir -p $(@D)
	$(CC) $(CTOR_BASE) $< -lamiga -lstubs -o $@

$(CTOR_DIAG_DIR)/test_ctor_locale: examples/amigaos3/test_ctor_locale.c
	@mkdir -p $(@D)
	$(CC) $(CTOR_BASE) $< -lamiga -lstubs -o $@

$(CTOR_DIAG_DIR)/test_ctor_atomic: examples/amigaos3/test_ctor_atomic.c
	@mkdir -p $(@D)
	$(CC) $(CTOR_BASE) $< -lamiga -latomic -lstubs -o $@

ctordiag-clib2: $(CTOR_DIAG_DIR)/test_ctor_math \
                $(CTOR_DIAG_DIR)/test_ctor_stdio \
                $(CTOR_DIAG_DIR)/test_ctor_locale \
                $(CTOR_DIAG_DIR)/test_ctor_atomic


