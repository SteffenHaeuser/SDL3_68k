CC=m68k-amigaos-gcc
AR=m68k-amigaos-ar
RANLIB=m68k-amigaos-ranlib
COMMON=-std=gnu99 -O2 -mcpu=68040 -mhard-float -Wall -Wextra -Wno-unused-parameter -I./include -I./include/build_config -I./include/SDL3 -I./src -D__AMIGAOS3__
CLIB2=$(COMMON) -mcrt=clib2 -DNOIXEMUL
LIBNIX=$(COMMON) -noixemul -DNOIXEMUL
SOURCES=$(wildcard ./src/*.c ./src/atomic/*.c ./src/audio/*.c ./src/audio/amigaos3/*.c ./src/camera/*.c ./src/camera/dummy/*.c ./src/cpuinfo/*.c ./src/dialog/*.c ./src/dialog/amigaos3/*.c ./src/events/*.c ./src/gpu/SDL_gpu.c ./src/haptic/*.c ./src/io/*.c ./src/io/generic/SDL_asyncio_generic.c ./src/joystick/*.c ./src/joystick/amigaos3/*.c ./src/libm/*.c ./src/loadso/dummy/*.c ./src/locale/*.c ./src/locale/amigaos3/*.c ./src/main/generic/*.c ./src/main/SDL_main_callbacks.c ./src/main/SDL_runapp.c ./src/misc/*.c ./src/power/*.c ./src/process/*.c ./src/process/dummy/*.c ./src/render/*.c ./src/render/software/*.c ./src/sensor/*.c ./src/sensor/dummy/*.c ./src/stdlib/*.c ./src/storage/SDL_storage.c ./src/storage/generic/SDL_genericstorage.c ./src/thread/*.c ./src/thread/amigaos3/*.c ./src/thread/generic/SDL_syscond.c ./src/thread/generic/SDL_sysrwlock.c ./src/time/SDL_time.c ./src/time/amigaos3/SDL_systime.c ./src/timer/*.c ./src/timer/amigaos3/*.c ./src/tray/SDL_tray_utils.c ./src/tray/dummy/*.c ./src/video/*.c ./src/video/yuv2rgb/yuv_rgb_std.c ./src/video/amigaos3/*.c ./src/video/dummy/*.c ./src/filesystem/SDL_filesystem.c ./src/filesystem/amigaos3/*.c)
REL=$(patsubst ./%,%,$(SOURCES:.c=.o))
CLOBJ=$(addprefix build/clib2/,$(REL))
LNOBJ=$(addprefix build/libnix/,$(REL))

TESTLIB_SOURCES=$(wildcard ./src/test/*.c)
TESTLIB_REL=$(patsubst ./%,%,$(TESTLIB_SOURCES:.c=.o))
TESTLIB_CLOBJ=$(addprefix build/clib2/,$(TESTLIB_REL))
TESTLIB_LNOBJ=$(addprefix build/libnix/,$(TESTLIB_REL))
all: clib2
clib2: build/clib2/libSDL3.a build/clib2/libSDL3_test.a
libnix: build/libnix/libSDL3.a build/libnix/libSDL3_test.a
both: clib2 libnix
build/clib2/libSDL3.a: $(CLOBJ)
	@mkdir -p $(@D)
	$(AR) crs $@ $^
	$(RANLIB) $@
build/libnix/libSDL3.a: $(LNOBJ)
	@mkdir -p $(@D)
	$(AR) crs $@ $^
	$(RANLIB) $@
build/clib2/libSDL3_test.a: $(TESTLIB_CLOBJ)
	@mkdir -p $(@D)
	$(AR) crs $@ $^
	$(RANLIB) $@

build/libnix/libSDL3_test.a: $(TESTLIB_LNOBJ)
	@mkdir -p $(@D)
	$(AR) crs $@ $^
	$(RANLIB) $@

build/clib2/%.o: %.c
	@mkdir -p $(@D)
	$(CC) $(CLIB2) -c $< -o $@
build/libnix/%.o: %.c
	@mkdir -p $(@D)
	$(CC) $(LIBNIX) -c $< -o $@
# Diagnostic software-only variant: no MiniGL backend object and no -lminigl.
SW_SOURCES=$(filter-out ./src/video/amigaos3/SDL_os3opengl.c,$(SOURCES))
SW_REL=$(patsubst ./%,%,$(SW_SOURCES:.c=.o))
SW_CLOBJ=$(addprefix build/clib2-sw/,$(SW_REL))
SW_CLIB2=$(COMMON) -mcrt=clib2 -DNOIXEMUL -DSDL_AMIGAOS3_SW_ONLY=1
TEST_LIBS_SW=-ldebug -lamiga -lm -latomic -lstubs

swonly-clib2: build/clib2-sw/libSDL3_sw.a

build/clib2-sw/libSDL3_sw.a: $(SW_CLOBJ)
	@mkdir -p $(@D)
	$(AR) crs $@ $^
	$(RANLIB) $@

build/clib2-sw/%.o: %.c
	@mkdir -p $(@D)
	$(CC) $(SW_CLIB2) -c $< -o $@

build/clib2-sw/examples/test_sw: examples/amigaos3/test_sw.c build/clib2-sw/libSDL3_sw.a
	@mkdir -p $(@D)
	$(CC) -std=gnu99 -O2 -mcpu=68040 -mhard-float -mcrt=clib2 -DNOIXEMUL -DSDL_AMIGAOS3_SW_ONLY=1 $(TEST_COMMON) $< build/clib2-sw/libSDL3_sw.a $(TEST_LIBS_SW) -o $@

test-swonly-clib2: build/clib2-sw/examples/test_sw

clean:
	rm -rf build/clib2 build/libnix build/clib2-sw

# Simple AmigaOS3 smoke tests (no external data files)
TEST_COMMON=-I./include -I./include/build_config -I./include/SDL3 -D__AMIGAOS3__
TEST_LIBS=-lminigl -ldebug -lamiga -lm -latomic -lstubs

